#!/usr/bin/env bash
# ==============================================================================
# mbf CLI — Micro Bash Framework command-line interface
# ==============================================================================

MBF_HOME="${MBF_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export MBF_HOME

function mbf_cli_help() {
    cat <<EOF
mbf — Micro Bash Framework CLI

Usage:
  mbf --init | init                           Print path to framework.sh for sourcing:
                                              source "\$(mbf --init)"
  mbf version [check|update|change|list]      Show version, check updates, update, list tags, or change tag
  mbf export <script.sh> [-o <out>] [--bundle-dir <dir>] [--full-module]
                                              Export standalone script or full app bundle directory
  mbf doctor <script_or_ext.sh>               Diagnose & validate script, custom extensions & templates
  mbf remote [--self-remove] <user@host> <script.sh> [-- ...]
                                              Export & run a local script agentlessly on a remote host via SSH
  mbf ai <ask|ask-json|analyze|cmd|run> [...] Run AI log analysis, JSON queries, or safe command generation
  mbf test [filter]                           Run the mbf automated test suite
  mbf list                                    List available core libraries and plugins
  mbf plugin <list|add|update|remove|run>     Manage plugin & script repositories (.installed_plugins)
  mbf new [--ext] <name.sh>                   Create a new mbf script or custom extension scaffold
  mbf -v | --version                          Print mbf version
  mbf -h | --help | help                      Show this help message
EOF
}

function _mbf_list_dir() {
    local label="$1"
    local dir="$2"
    printf '%s (%s):\n' "$label" "$dir"
    local mod_file mod_name fns
    for mod_file in "$dir"/*.sh; do
        [ -f "$mod_file" ] || continue
        mod_name="$(basename "$mod_file" .sh)"
        fns="$(grep -E '^[[:space:]]*function[[:space:]]+mbf::' "$mod_file" | sed -E 's/^[[:space:]]*function[[:space:]]+([a-zA-Z0-9_:]+).*/\1/' | tr '\n' ' ')"
        printf '  %-11s : %s\n' "$mod_name" "$fns"
    done
    printf '\n'
}

function _mbf_cli_main() {
    local cmd="${1:-help}"
    shift 1 2>/dev/null || true

    case "$cmd" in
        --init|init)
            printf '%s\n' "${MBF_HOME}/framework.sh"
            ;;
        update)
            # shellcheck disable=SC1091
            source "${MBF_HOME}/framework.sh"
            mbf::update "$@"
            ;;
        export)
            # shellcheck disable=SC1091
            source "${MBF_HOME}/framework.sh"
            mbf::check_update
            # shellcheck disable=SC1091
            source "${MBF_HOME}/tools/exporter.sh"
            mbf::exporter::run "$@"
            ;;
        doctor)
            # shellcheck disable=SC1091
            source "${MBF_HOME}/framework.sh"
            mbf::check_update
            # shellcheck disable=SC1091
            source "${MBF_HOME}/tools/doctor.sh"
            mbf::doctor::run "$@"
            ;;
        remote)
            local -a r_flags=()
            if [ "${1:-}" == "--self-remove" ]; then
                r_flags+=(--self-remove)
                shift 1
            fi
            local r_host="${1:-}" r_script="${2:-}"
            shift 2 2>/dev/null || true
            [ "${1:-}" == "--" ] && shift 1
            if [ -z "$r_host" ] || [ -z "$r_script" ]; then
                echo "Usage: mbf remote [--self-remove] <user@host> <script.sh> [-- args...]" >&2
                return 1
            fi
            # shellcheck disable=SC1091
            source "${MBF_HOME}/framework.sh"
            mbf::use ssh
            mbf::ssh::exec_script ${r_flags[@]+"${r_flags[@]}"} "$r_host" "$r_script" "$@"
            ;;
        ai)
            local ai_sub="${1:-}"
            shift 1 2>/dev/null || true
            # shellcheck disable=SC1091
            source "${MBF_HOME}/framework.sh"
            mbf::use ai
            case "$ai_sub" in
                ask)      mbf::ai::ask "$@" ;;
                ask-json) mbf::ai::ask_json "$@" ;;
                analyze)  mbf::ai::analyze "$@" ;;
                cmd)      mbf::ai::cmd "$@" ;;
                run)      mbf::ai::run "$@" ;;
                detect)   mbf::ai::detect ;;
                *)        echo "Usage: mbf ai <ask|ask-json|analyze|cmd|run|detect> [args...]" >&2; return 1 ;;
            esac
            ;;
        test)
            bash "${MBF_HOME}/test/run.sh" "$@"
            ;;
        list)
            _mbf_list_dir "Core Libraries" "${MBF_HOME}/lib"
            _mbf_list_dir "Plugins" "${MBF_HOME}/plugins"
            local udir="${MBF_USER_PLUGINS_DIR:-${MBF_USER_DATA_DIR:-${XDG_DATA_HOME:-${HOME:-/tmp}/.local/share}/mbf}/plugins}"
            if [ -d "$udir" ] && compgen -G "${udir}/*.sh" >/dev/null 2>&1; then
                _mbf_list_dir "User Plugins" "$udir"
            fi
            ;;
        plugin)
            local p_sub="${1:-list}"
            shift 1 2>/dev/null || true
            # shellcheck disable=SC1091
            MBF_NO_UPDATE_CHECK=1 source "${MBF_HOME}/framework.sh"
            # shellcheck disable=SC1091
            source "${MBF_HOME}/tools/plugin.sh"
            case "$p_sub" in
                list)      mbf::plugin::list "$@" ;;
                add)       mbf::plugin::add "$@" ;;
                update)    mbf::plugin::update "$@" ;;
                remove|rm) mbf::plugin::remove "$@" ;;
                run)       mbf::plugin::run "$@" ;;
                *)         echo "Usage: mbf plugin <list|add|update|remove|run> [...]" >&2; return 1 ;;
            esac
            ;;
        new)
            local is_ext=0
            if [ "${1:-}" == "--ext" ] || [ "${1:-}" == "--plugin" ] || [ "${1:-}" == "--lib" ]; then
                is_ext=1
                shift 1
            fi
            local target_file="${1:-}"
            if [ -z "$target_file" ]; then
                echo "Usage: mbf new [--ext] <script_or_ext.sh>" >&2
                return 1
            fi
            if [ -e "$target_file" ]; then
                echo "Error: '$target_file' already exists." >&2
                return 1
            fi
            # shellcheck disable=SC1091
            source "${MBF_HOME}/framework.sh"
            mbf::use template
            if [ "$is_ext" -eq 1 ]; then
                local mod_name mod_upper
                mod_name="$(basename "$target_file" .sh)"
                mod_upper="${mod_name//[^a-zA-Z0-9_]/_}"
                mod_upper="${mod_upper^^}"
                mbf::template::render "script/extension.sh.tpl" "$target_file" \
                    "MODULE_NAME=${mod_name}" \
                    "MODULE_UPPER=${mod_upper}" || return 1
            else
                mbf::template::render "script/script.sh.tpl" "$target_file" || return 1
            fi
            chmod +x "$target_file" 2>/dev/null || true
            echo "Created $target_file"
            ;;
        -v|--version)
            # shellcheck disable=SC1091
            MBF_NO_UPDATE_CHECK=1 source "${MBF_HOME}/framework.sh"
            printf 'mbf v%s\n' "$(mbf::version)"
            ;;
        version)
            local v_sub="${1:-show}"
            shift 1 2>/dev/null || true
            # shellcheck disable=SC1091
            MBF_NO_UPDATE_CHECK=1 source "${MBF_HOME}/framework.sh"
            case "$v_sub" in
                show|"")  printf 'mbf v%s\n' "$(mbf::version)" ;;
                check)    mbf::check_update --force ;;
                update)   mbf::update "$@" ;;
                change)   mbf::switch_version "$@" ;;
                list)     mbf::list_versions ;;
                *)        echo "Usage: mbf version [check | update [branch] | change <tag> [--force] | list]" >&2; return 1 ;;
            esac
            ;;
        completion)
            local shell_name="${1:-}"
            case "$shell_name" in
                bash)
                    cat <<'EOF'
# mbf Bash completion — add to ~/.bashrc: eval "$(mbf completion bash)"
_mbf_completions() {
    local cur prev cmd
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    cmd="${COMP_WORDS[1]:-}"

    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=( $(compgen -W "init version list plugin new doctor remote ai export test help" -- "$cur") )
        return 0
    fi

    case "$cmd" in
        version)
            COMPREPLY=( $(compgen -W "check update change list" -- "$cur") )
            ;;
        plugin)
            COMPREPLY=( $(compgen -W "list add update remove run" -- "$cur") )
            ;;
        ai)
            COMPREPLY=( $(compgen -W "ask ask-json analyze cmd run detect" -- "$cur") )
            ;;
        completion)
            COMPREPLY=( $(compgen -W "bash zsh" -- "$cur") )
            ;;
        export)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "-o --bundle-dir --full-module" -- "$cur") )
            elif [ "$prev" == "-o" ] || [ "$prev" == "--bundle-dir" ]; then
                COMPREPLY=( $(compgen -f -- "$cur") )
            else
                COMPREPLY=( $(compgen -f -X '!*.sh' -- "$cur") )
            fi
            ;;
        new)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "--ext" -- "$cur") )
            else
                COMPREPLY=( $(compgen -f -- "$cur") )
            fi
            ;;
        doctor)
            COMPREPLY=( $(compgen -f -X '!*.sh' -- "$cur") )
            ;;
        remote)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "--self-remove" -- "$cur") )
            elif [ -r "$HOME/.ssh/config" ] && [ "$COMP_CWORD" -le 3 ]; then
                local hosts
                hosts="$(awk '/^[[:space:]]*Host[[:space:]]+/ {for(i=2;i<=NF;i++) if($i !~ /[*?]/) print $i}' "$HOME/.ssh/config" 2>/dev/null)"
                COMPREPLY=( $(compgen -W "$hosts" -- "$cur") $(compgen -f -X '!*.sh' -- "$cur") )
            else
                COMPREPLY=( $(compgen -f -X '!*.sh' -- "$cur") )
            fi
            ;;
    esac
}
complete -F _mbf_completions mbf
EOF
                    ;;
                zsh)
                    cat <<'EOF'
# mbf Zsh completion — add to ~/.zshrc: eval "$(mbf completion zsh)"
autoload -Uz bashcompinit && bashcompinit
eval "$(mbf completion bash)"
EOF
                    ;;
                *)
                    echo "Usage: mbf completion <bash|zsh>" >&2
                    return 1
                    ;;
            esac
            ;;
        -h|--help|help)
            mbf_cli_help
            ;;
        *)
            echo "mbf: unknown command '$cmd'" >&2
            mbf_cli_help >&2
            return 1
            ;;
    esac
}

_mbf_cli_main "$@"
